# Raise upload limits for mod_php setups.
# Guarded so servers without mod_php (FPM/CGI) don't 500 — those read .user.ini.
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 21M
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 21M
</IfModule>
